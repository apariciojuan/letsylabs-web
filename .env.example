# Copy to .env (ignored by git). No real secrets here.
# UID/GID: passed as build args to .devcontainer/Dockerfile so the container's `node` user matches
# your host user and bind-mounted files stay writable (docs/specs/workspace_contenedores_dev.md
# §2 D-CONT-2/D-CONT-4). Find yours with `id -u` / `id -g`.
UID=1000
GID=1000

# Build-time flag (Vite/Astro auto-exposes PUBLIC_-prefixed vars via import.meta.env): flips the
# global CTA from "Get early access" (pre-GA) to "Start building" (post-GA) and switches /pricing's
# layout (W-6). Default false until the GA launch decision is made.
PUBLIC_GA_LAUNCHED=false
