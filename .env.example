# Copy to .env (ignored by git). No real secrets here.
# UID/GID: passed as build args to .devcontainer/Dockerfile so the container's `node` user matches
# your host user and bind-mounted files stay writable (docs/specs/workspace_contenedores_dev.md
# §2 D-CONT-2/D-CONT-4). Find yours with `id -u` / `id -g`.
UID=1000
GID=1000
