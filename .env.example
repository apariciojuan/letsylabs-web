# Copy to .env (ignored by git). No real secrets here.
# UID/GID: passed as build args to .devcontainer/Dockerfile so the container's `node` user matches
# your host user and bind-mounted files stay writable (docs/specs/workspace_contenedores_dev.md
# §2 D-CONT-2/D-CONT-4). Find yours with `id -u` / `id -g`.
UID=1000
GID=1000

# Build-time flag (Vite/Astro auto-exposes PUBLIC_-prefixed vars via import.meta.env): flips the
# global CTA from "Get early access" (pre-GA) to "Start building" (post-GA) and switches /pricing's
# layout (W-6). Default false until the GA launch decision is made.
PUBLIC_GA_LAUNCHED=false

# Canonical origin (brief W-8): every absolute URL the build emits -- canonical link, hreflang
# alternates, og:url, sitemap.xml locs and schema.org JSON-LD -- is built from this origin via
# `astro.config.mjs`'s `site` option (`Astro.site`). Provisional until the real domain is confirmed
# (workspace 🔴 walkthrough); `https://letsylabs.com` is the placeholder both here and as the default
# in `astro.config.mjs` if the variable is ever unset. Must be an absolute origin with NO trailing
# slash and NO path (`new URL(path, PUBLIC_SITE_URL)` in src/lib/seo.ts assumes that).
PUBLIC_SITE_URL=https://letsylabs.com

# Early-access form submission target (brief W-7, D-W7-1): Formspree endpoint in production
# (an absolute https:// URL -- `astro build` fails otherwise, D-W7-4). Empty/unset (the default
# here) is FAIL-CLOSED: EarlyAccessForm renders no <form> at all, only the mailto: CTA -- never
# leave this empty by accident thinking it "just disables validation". The `web` service in
# compose.dev.yml overrides this to `/__dev/waitlist` (a dev-only mock) so the real <form> can be
# exercised locally without a live Formspree account.
PUBLIC_WAITLIST_ENDPOINT=
