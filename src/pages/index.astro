---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomePage from '../components/home/HomePage.astro';
import { t } from '../i18n';
import { siteOrigin } from '../lib/seo';
import { softwareApplicationSchema } from '../lib/schema';
---

<BaseLayout
  locale="en"
  title={t('en', 'home.meta.title')}
  description={t('en', 'home.meta.description')}
  jsonLd={softwareApplicationSchema('en', siteOrigin(Astro.site))}
>
  <HomePage locale="en" />
</BaseLayout>
