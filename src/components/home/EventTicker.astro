---
/**
 * Event ticker (brief W-3, W3-1b / "letsylabs Homepage.dc.html" lines 126-149): a full-width band
 * under the hero, a mono line of real system events marquee-scrolling in a 32s loop (duplicated
 * content, `.marquee` from tokens.css, W-2). `prefers-reduced-motion` freezes it via the global
 * rule in tokens.css.
 *
 * The 8 items (event name/latency/dot color) are literal, not i18n -- same decision as the code
 * snippets (docs/plans/web/03_homepage.md: "Nombres de eventos, código y ticker no se traducen").
 * Only the container's `aria-label` is translated.
 */
import { t, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

type Accent = 'signal' | 'tel' | 'event';

/**
 * `hasTargetFigure` (brief W-9, CLAIMS_MATRIX rule 6): 6 of these 8 items carry an unmeasured
 * latency (R-11 pending) with no marking at all until now -- a real gap found during the W-9 audit
 * (the Developers section's counters and the /voice diagram already had target treatment, this
 * ticker had none). The other 2 items ("ok", the DTMF digit) are not timing figures. Stamped as
 * `data-claim-state="target"` on the item itself (DOM-only, see CLAIMS_MATRIX.md) rather than
 * adding new visible copy to this already-shipped, handoff-fidelity-sensitive marquee band.
 */
const ITEMS: { text: string; accent: Accent; hasTargetFigure: boolean }[] = [
  { text: 'stt.partial · 118ms', accent: 'event', hasTargetFigure: true },
  { text: 'stt.final · 142ms', accent: 'event', hasTargetFigure: true },
  { text: 'agent.first_token · 210ms', accent: 'signal', hasTargetFigure: true },
  { text: 'tts.first_audio · 96ms', accent: 'signal', hasTargetFigure: true },
  { text: 'call.transfer.human · ok', accent: 'tel', hasTargetFigure: false },
  { text: 'trace.exported · 1.2s', accent: 'event', hasTargetFigure: true },
  { text: 'dtmf.received · "3"', accent: 'tel', hasTargetFigure: false },
  { text: 'turn.barge_in · 61ms', accent: 'signal', hasTargetFigure: true },
];
---

<div class="ticker" role="group" aria-label={t(locale, 'home.ticker.ariaLabel')}>
  <div class="ticker-track marquee">
    <div class="ticker-group">
      {
        ITEMS.map((item) => (
          <span class="ticker-item" data-claim-state={item.hasTargetFigure ? 'target' : undefined}>
            <span class:list={['ticker-dot', `ticker-dot-${item.accent}`]} aria-hidden="true">
              ●
            </span>{' '}
            {item.text}
          </span>
        ))
      }
    </div>
    <div class="ticker-group" aria-hidden="true">
      {
        ITEMS.map((item) => (
          <span class="ticker-item" data-claim-state={item.hasTargetFigure ? 'target' : undefined}>
            <span class:list={['ticker-dot', `ticker-dot-${item.accent}`]} aria-hidden="true">
              ●
            </span>{' '}
            {item.text}
          </span>
        ))
      }
    </div>
  </div>
</div>

<style>
  .ticker {
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    overflow: hidden;
    background: var(--surface);
  }

  .ticker-group {
    display: inline-flex;
    gap: 56px;
    padding: 10px 28px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--muted);
  }

  .ticker-dot-event {
    color: var(--event);
  }

  .ticker-dot-signal {
    color: var(--signal);
  }

  .ticker-dot-tel {
    color: var(--tel);
  }
</style>
