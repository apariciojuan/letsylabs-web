---
/**
 * Final CTA (brief W-3, W3-3a / "letsylabs Homepage.dc.html" lines 428-445; real form wired in
 * W-7). Reads `PUBLIC_WAITLIST_ENDPOINT` itself -- same pattern already used here for
 * `PUBLIC_GA_LAUNCHED` -- and hands it to `EarlyAccessForm` as a prop, which fail-closed renders
 * only a `mailto:` CTA when it's empty (D-W7-1). `EarlyAccessForm.test.ts` is where both states get
 * exercised directly (via that prop, no env faking needed); this component's own test only needs
 * the default (no endpoint) state Vitest's env gives it, same as before W-7.
 */
import EarlyAccessForm from '../EarlyAccessForm.astro';
import { t, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const endpoint = import.meta.env.PUBLIC_WAITLIST_ENDPOINT;
---

<section id="cta" class="final-cta radial-signal" style="--radial-x:50%;--radial-y:100%">
  <div class="final-cta-inner container">
    <h2 class="final-cta-h2" data-reveal>{t(locale, 'home.finalCta.h2')}</h2>
    <div data-reveal data-delay="100">
      <EarlyAccessForm locale={locale} endpoint={endpoint} />
    </div>
    <div class="final-cta-note">{t(locale, 'home.finalCta.note')}</div>
  </div>
</section>

<style>
  .final-cta {
    position: relative;
    border-top: 1px solid var(--line);
    overflow: hidden;
  }

  .final-cta-inner {
    max-width: 760px;
    padding: 104px 32px;
    text-align: center;
    position: relative;
  }

  .final-cta-h2 {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(30px, 3.6vw, 42px);
    letter-spacing: -0.8px;
    line-height: 1.15;
    margin: 0 0 36px;
  }

  .final-cta-actions {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    justify-content: center;
    margin-bottom: 20px;
  }

  .final-cta-note {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--muted);
  }
</style>
