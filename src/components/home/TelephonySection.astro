---
/**
 * Telephony section (brief W-3, W3-2a / "letsylabs Homepage.dc.html" lines 228-251): two call-path
 * rows (your trunk → letsylabs, available at GA; managed numbers → letsylabs, coming soon, at 55%
 * opacity) with an amber CSS pulse traveling the first line (`telpulse`, W-2 tokens.css), plus the
 * telephony claim line.
 */
import Badge from '../Badge.astro';
import Eyebrow from '../Eyebrow.astro';
import SectionHeading from '../SectionHeading.astro';
import { t, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<section id="telephony" class="telephony-section container">
  <div class="telephony-header" data-reveal>
    <Eyebrow tone="tel">{t(locale, 'home.telephony.eyebrow')}</Eyebrow>
    <SectionHeading class="telephony-h2">{t(locale, 'home.telephony.h2')}</SectionHeading>
    <p class="telephony-text">{t(locale, 'home.telephony.text')}</p>
  </div>

  <div class="telephony-rows" data-reveal>
    <div class="telephony-row">
      <div class="telephony-node">
        {t(locale, 'home.telephony.yourTrunk')}
        <span class="telephony-node-sub">{t(locale, 'home.telephony.yourTrunkSub')}</span>
      </div>
      <div class="telephony-line telephony-line-pulsing">
        <span class="telephony-line-dot" aria-hidden="true"></span>
      </div>
      <div class="telephony-node">letsylabs</div>
      <Badge variant="available">{t(locale, 'home.telephony.availableAtGa')}</Badge>
    </div>

    <div class="telephony-row telephony-row-muted">
      <div class="telephony-node">
        {t(locale, 'home.telephony.managedNumbers')}
        <span class="telephony-node-sub">{t(locale, 'home.telephony.managedNumbersSub')}</span>
      </div>
      <div class="telephony-line"></div>
      <div class="telephony-node">letsylabs</div>
      <Badge variant="coming-soon">{t(locale, 'nav.megaMenu.comingSoon')}</Badge>
    </div>

    <div class="telephony-claim">{t(locale, 'home.telephony.claim')}</div>
  </div>
</section>

<style>
  .telephony-section {
    padding: 80px 32px;
  }

  .telephony-header {
    max-width: 640px;
    margin-bottom: 40px;
  }

  :global(.telephony-h2) {
    margin: 0 0 16px;
  }

  .telephony-text {
    font-size: 16px;
    line-height: 1.6;
    color: var(--muted);
    margin: 0;
  }

  .telephony-rows {
    display: flex;
    flex-direction: column;
    gap: 14px;
    max-width: 860px;
  }

  .telephony-row {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    padding: 20px 24px;
    display: flex;
    align-items: center;
    gap: 20px;
    flex-wrap: wrap;
  }

  .telephony-row-muted {
    opacity: 0.55;
  }

  .telephony-node {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--ink);
    white-space: nowrap;
  }

  .telephony-node-sub {
    display: block;
    font-size: 11px;
    color: var(--muted);
    margin-top: 3px;
    white-space: normal;
  }

  .telephony-line {
    flex: 1;
    min-width: 120px;
    position: relative;
    height: 1px;
    background: rgba(255, 255, 255, 0.12);
  }

  .telephony-line-pulsing {
    background: rgba(255, 180, 84, 0.3);
  }

  .telephony-line-dot {
    position: absolute;
    top: -3px;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--tel);
    box-shadow: 0 0 8px var(--tel);
    animation: telpulse 2.4s linear infinite;
  }

  .telephony-claim {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--tel);
    padding: 6px 2px;
  }
</style>
