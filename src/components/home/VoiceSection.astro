---
/**
 * Voice section (brief W-3, W3-2a / "letsylabs Homepage.dc.html" lines 183-226): a 2x2 grid of
 * event-labeled feature cards, plus a micro-demo card (CSS equalizer + a word-by-word transcript
 * loop driven by `src/scripts/voice-transcript.ts`).
 */
import Card from '../Card.astro';
import SectionHeading from '../SectionHeading.astro';
import Eyebrow from '../Eyebrow.astro';
import { t, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const CARDS = [
  { key: 'stt', delay: 0 },
  { key: 'tts', delay: 60 },
  { key: 'turns', delay: 120 },
  { key: 'latency', delay: 180 },
] as const;

const EQ_DELAYS_MS = [0, 90, 180, 270, 360, 450, 540, 630];
---

<section id="voice" class="voice-section container">
  <div class="voice-header" data-reveal>
    <Eyebrow>{t(locale, 'home.voice.eyebrow')}</Eyebrow>
    <SectionHeading class="voice-h2">{t(locale, 'home.voice.h2')}</SectionHeading>
  </div>
  <div class="voice-grid">
    {
      CARDS.map(({ key, delay }) => (
        <Card hoverable data-reveal data-delay={delay}>
          <div class="voice-card-event">{t(locale, `home.voice.cards.${key}.event`)}</div>
          <div class="voice-card-title">{t(locale, `home.voice.cards.${key}.title`)}</div>
          <p class="voice-card-text">{t(locale, `home.voice.cards.${key}.text`)}</p>
        </Card>
      ))
    }
  </div>
  <Card hoverable={false} class="voice-demo" data-reveal>
    <div class="voice-eq" aria-hidden="true">
      {
        EQ_DELAYS_MS.map((delay) => (
          <span class="voice-eq-bar" style={`animation-delay:${delay}ms`} />
        ))
      }
    </div>
    <div class="voice-transcript-wrap">
      <div class="voice-transcript-label">{t(locale, 'home.voice.transcriptLabel')}</div>
      <div class="voice-transcript">
        <span data-voice-transcript></span><span class="blink-cursor" aria-hidden="true">▋</span>
      </div>
    </div>
  </Card>
</section>

<script>
  import { startVoiceTranscript } from '../../scripts/voice-transcript';

  const el = document.querySelector<HTMLElement>('[data-voice-transcript]');
  if (el) startVoiceTranscript(el);
</script>

<style>
  .voice-section {
    padding: 80px 32px;
  }

  .voice-header {
    max-width: 640px;
    margin-bottom: 48px;
  }

  :global(.voice-h2) {
    margin: 0;
  }

  .voice-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 16px;
    margin-bottom: 16px;
  }

  .voice-card-event {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--event);
    margin-bottom: 10px;
  }

  .voice-card-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 18px;
    margin-bottom: 8px;
  }

  .voice-card-text {
    font-size: 14px;
    line-height: 1.6;
    color: var(--muted);
    margin: 0;
  }

  :global(.voice-demo) {
    display: flex;
    align-items: center;
    gap: 24px;
    flex-wrap: wrap;
  }

  .voice-eq {
    display: flex;
    align-items: center;
    gap: 3px;
    height: 36px;
  }

  .voice-eq-bar {
    width: 3px;
    height: 100%;
    background: var(--signal);
    border-radius: 2px;
    animation: bar 1.1s ease-in-out infinite;
    transform-origin: center;
  }

  .voice-transcript-wrap {
    flex: 1;
    min-width: 260px;
  }

  .voice-transcript-label {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--event);
    margin-bottom: 6px;
  }

  .voice-transcript {
    font-family: var(--font-mono);
    font-size: 15px;
    color: var(--ink);
    min-height: 24px;
  }
</style>
