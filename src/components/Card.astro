---
/**
 * Surface card (README §Espaciado y forma / §2.6): `surface` background, `line` border, radius
 * 12px, padding 24-28px. Hover (150ms): border → accent at 40%, background → `surface-2`. The
 * accent is `signal` (green) by default; `tone="amber"` is the Telephony-page variant (`tel`).
 * `hoverable=false` renders a static card (no hover transition) for non-interactive contexts.
 *
 * Forwards any other attribute (`...rest`) onto the wrapper div -- bug found in W-3: every homepage
 * section stacks its cards via `[data-reveal]`/`data-delay` (site-fx.ts), and a Card is the grid/flex
 * item those attributes need to sit on directly (a wrapping div would work too, but would make every
 * caller repeat that boilerplate). Without this, `<Card data-reveal>` silently dropped the attribute
 * -- caught before it shipped; regression test in Card.test.ts.
 */
export type CardTone = 'default' | 'amber';

interface Props {
  tone?: CardTone;
  hoverable?: boolean;
  class?: string;
  [key: `data-${string}`]: unknown;
}

const { tone = 'default', hoverable = true, class: className, ...rest } = Astro.props;
---

<div class:list={['card', `card-${tone}`, { 'card-hoverable': hoverable }, className]} {...rest}>
  <slot />
</div>

<style>
  .card {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    padding: 24px;
  }

  .card-hoverable {
    transition:
      border-color var(--transition-hover),
      background var(--transition-hover);
  }

  .card-hoverable:hover {
    background: var(--surface-2);
  }

  .card-default.card-hoverable:hover {
    border-color: rgba(74, 242, 161, 0.4);
  }

  .card-amber.card-hoverable:hover {
    border-color: rgba(255, 180, 84, 0.4);
  }
</style>
