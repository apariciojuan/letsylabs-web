---
/**
 * /open-source (brief W-4, W4-2b / "OpenSource.dc.html"): hero + 3 repo-style crate cards + a
 * philosophy block. The handoff's GitHub button links to github.com/letsylabs, but the repo does
 * not exist yet (brief decision, hueco marcado hasta R-17): rendered as a disabled `<span>` with
 * `aria-disabled="true"` and a `COMING SOON` badge next to it, never a fake `mailto:` link
 * disguised as a GitHub link.
 */
import Badge from '../Badge.astro';
import Card from '../Card.astro';
import PageHero from '../PageHero.astro';
import { t, type Locale } from '../../i18n';
import { localizePath } from '../../i18n/routing';
import { ctaLabelKey, ROUTES } from '../../lib/nav-links';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const gaLaunched = import.meta.env.PUBLIC_GA_LAUNCHED === 'true';

const CRATE_CARDS = ['types', 'vad', 'adapters'] as const;
---

<PageHero
  eyebrow={t(locale, 'openSource.hero.eyebrow')}
  heading={t(locale, 'openSource.hero.h1')}
  headingMaxWidth={780}
  sub={t(locale, 'openSource.hero.sub')}
  subMaxWidth={620}
  accent="signal"
  ctas={[
    { href: '#crates', label: t(locale, 'openSource.hero.ctaCrates') },
    {
      href: localizePath(ROUTES.pricing, locale),
      label: t(locale, ctaLabelKey(gaLaunched)),
      variant: 'ghost',
    },
  ]}
/>

<section id="crates" class="os-crates container">
  <div class="os-crates-grid">
    {
      CRATE_CARDS.map((key, index) => (
        <Card hoverable data-reveal data-delay={index * 60}>
          <div class="os-crate-header">
            <span class="os-crate-name">{t(locale, `openSource.crates.${key}.name`)}</span>
            <span class="os-crate-stars">{t(locale, 'openSource.crates.stars')}</span>
          </div>
          <p class="os-crate-text">{t(locale, `openSource.crates.${key}.text`)}</p>
          <div class="os-crate-chips">
            <span class="os-chip">{t(locale, 'openSource.crates.license')}</span>
            <span class="os-chip">{t(locale, 'openSource.crates.language')}</span>
          </div>
        </Card>
      ))
    }
  </div>
  <div class="os-crates-footer" data-reveal>
    <span class="os-github-disabled" aria-disabled="true">
      {t(locale, 'openSource.crates.githubLabel')}
    </span>
    <Badge variant="coming-soon">{t(locale, 'openSource.crates.githubBadge')}</Badge>
    <Badge variant="coming-soon">{t(locale, 'openSource.crates.pythonBindings')}</Badge>
  </div>
</section>

<section class="os-philosophy container">
  <div class="os-philosophy-block" data-reveal>
    <div class="os-philosophy-label">{t(locale, 'openSource.philosophy.label')}</div>
    <p class="os-philosophy-text">
      {t(locale, 'openSource.philosophy.line1')}<br />
      {t(locale, 'openSource.philosophy.line2')}<br />
      {t(locale, 'openSource.philosophy.line3')}
    </p>
  </div>
</section>

<script>
  import { initFX } from '../../scripts/site-fx';
  initFX(document);
</script>

<style>
  .os-crates {
    padding: 40px 32px 56px;
  }

  .os-crates-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 16px;
    margin-bottom: 20px;
  }

  .os-crate-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 8px;
  }

  .os-crate-name {
    font-family: var(--font-mono);
    font-size: 14px;
  }

  .os-crate-stars {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--muted);
  }

  .os-crate-text {
    font-size: 13.5px;
    line-height: 1.55;
    color: var(--muted);
    margin: 0 0 16px;
  }

  .os-crate-chips {
    display: flex;
    gap: 10px;
    font-family: var(--font-mono);
    font-size: 10.5px;
    color: var(--muted);
  }

  .os-chip {
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-badge);
    padding: 2px 7px;
  }

  .os-crates-footer {
    display: flex;
    gap: 14px;
    align-items: center;
    flex-wrap: wrap;
  }

  .os-github-disabled {
    border: 1px solid rgba(255, 255, 255, 0.14);
    color: var(--muted);
    font-size: 14px;
    font-weight: 500;
    padding: 10px 18px;
    border-radius: var(--radius-sm);
    display: inline-flex;
    align-items: center;
    gap: 8px;
    cursor: not-allowed;
  }

  .os-philosophy {
    padding: 0 32px 88px;
  }

  .os-philosophy-block {
    max-width: 640px;
    border-left: 2px solid rgba(74, 242, 161, 0.5);
    padding-left: 24px;
  }

  .os-philosophy-label {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 1.5px;
    color: var(--muted);
    margin-bottom: 14px;
  }

  .os-philosophy-text {
    font-size: 16px;
    line-height: 1.7;
    margin: 0;
    color: var(--ink);
  }
</style>
