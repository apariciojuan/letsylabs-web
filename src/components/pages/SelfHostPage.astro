---
/**
 * /self-host (brief W-4, W4-2a / "SelfHost.dc.html"): sovereignty hero (single `mailto:` CTA) + the
 * dashed "YOUR INFRASTRUCTURE" audio-path diagram + a `docker compose up -d` terminal (reusing
 * `CodeBlock` as a Terminal, same pattern as the Homepage's `SelfHostSection.astro`, but WITHOUT the
 * "voxtral" mention per the brief's decision) + a self-hosted vs. cloud comparison table + the
 * licensing line.
 */
import CodeBlock from '../CodeBlock.astro';
import PageHero from '../PageHero.astro';
import { t, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const COMPARISON_ROWS = ['apiStack', 'audioEgress', 'models', 'updates', 'pricing'] as const;
---

<PageHero
  eyebrow={t(locale, 'selfHost.hero.eyebrow')}
  heading={t(locale, 'selfHost.hero.h1')}
  headingMaxWidth={780}
  sub={t(locale, 'selfHost.hero.sub')}
  subMaxWidth={620}
  accent="signal"
  ctas={[{ href: 'mailto:hello@letsylabs.com', label: t(locale, 'selfHost.hero.cta') }]}
/>

<section class="sh-audio container">
  <div class="sh-audio-label" data-reveal>{t(locale, 'selfHost.audioNeverLeaves.label')}</div>
  <div class="sh-audio-box" data-reveal data-delay="80">
    <div class="sh-audio-badge">{t(locale, 'selfHost.audioNeverLeaves.badge')}</div>
    <div
      class="sh-audio-row"
      role="img"
      aria-label={t(locale, 'selfHost.audioNeverLeaves.ariaLabel')}
    >
      <div class="sh-audio-node">{t(locale, 'selfHost.audioNeverLeaves.nodes.audioIn')}</div>
      <span class="sh-audio-arrow" aria-hidden="true">→</span>
      <div class="sh-audio-node sh-audio-node-signal">
        {t(locale, 'selfHost.audioNeverLeaves.nodes.runtime')}
      </div>
      <span class="sh-audio-arrow" aria-hidden="true">→</span>
      <div class="sh-audio-node sh-audio-node-event">
        {t(locale, 'selfHost.audioNeverLeaves.nodes.sttTts')}
      </div>
      <span class="sh-audio-arrow" aria-hidden="true">→</span>
      <div class="sh-audio-node">{t(locale, 'selfHost.audioNeverLeaves.nodes.yourAgent')}</div>
    </div>
    <div class="sh-audio-caption">{t(locale, 'selfHost.audioNeverLeaves.caption')}</div>
  </div>
</section>

<section class="sh-terminal-table container">
  <div class="sh-terminal-col" data-reveal>
    <CodeBlock
      language="your-server"
      ariaLabel={t(locale, 'selfHost.terminal.ariaLabel')}
      class="sh-terminal"
    >
      <div data-reveal><span class="tok-comment">$</span> docker compose up -d</div>
      <div data-reveal data-delay="200">
        <span class="tok-string">✔</span> letsy-gateway <span class="tok-comment">Started 0.4s</span
        >
      </div>
      <div data-reveal data-delay="340">
        <span class="tok-string">✔</span> letsy-stt{' '}
        <span class="tok-comment">Started 1.1s · open weights</span>
      </div>
      <div data-reveal data-delay="480">
        <span class="tok-string">✔</span> letsy-tts{' '}
        <span class="tok-comment">Started 1.3s · open weights</span>
      </div>
      <div data-reveal data-delay="620">
        <span class="tok-string">✔</span> letsy-trace <span class="tok-comment">Started 0.6s</span>
      </div>
      <div data-reveal data-delay="800">
        runtime ready <span class="tok-keyword">wss://0.0.0.0:8443/audio</span>{' '}
        <span class="blink-cursor" aria-hidden="true">▋</span>
      </div>
    </CodeBlock>
    <div class="sh-requirements" data-reveal data-delay="150">
      {t(locale, 'selfHost.terminal.requirements')}
    </div>
  </div>

  <div class="sh-comparison-col" data-reveal data-delay="100">
    <div class="sh-comparison-scroll">
      <div
        class="sh-comparison"
        role="table"
        aria-label={t(locale, 'selfHost.comparison.selfHosted')}
      >
        <div class="sh-comparison-row sh-comparison-header" role="row">
          <div class="sh-comparison-cell" role="columnheader"></div>
          <div class="sh-comparison-cell sh-comparison-head-self" role="columnheader">
            {t(locale, 'selfHost.comparison.selfHosted')}
          </div>
          <div class="sh-comparison-cell sh-comparison-head-cloud" role="columnheader">
            {t(locale, 'selfHost.comparison.cloud')}
          </div>
        </div>
        {
          COMPARISON_ROWS.map((key, index) => (
            <div
              class:list={[
                'sh-comparison-row',
                { 'sh-comparison-row-last': index === COMPARISON_ROWS.length - 1 },
              ]}
              role="row"
            >
              <div class="sh-comparison-cell sh-comparison-label" role="cell">
                {t(locale, `selfHost.comparison.rows.${key}.label`)}
              </div>
              <div
                class:list={[
                  'sh-comparison-cell',
                  { 'sh-comparison-self-value': key === 'audioEgress' },
                ]}
                role="cell"
              >
                {t(locale, `selfHost.comparison.rows.${key}.selfHosted`)}
              </div>
              <div class="sh-comparison-cell" role="cell">
                {t(locale, `selfHost.comparison.rows.${key}.cloud`)}
              </div>
            </div>
          ))
        }
      </div>
    </div>
    <div class="sh-security-chips" data-reveal data-delay="200">
      <span class="sh-chip">{t(locale, 'selfHost.comparison.chips.encryption')}</span>
      <span class="sh-chip">{t(locale, 'selfHost.comparison.chips.isolation')}</span>
      <span class="sh-chip">{t(locale, 'selfHost.comparison.chips.keys')}</span>
    </div>
  </div>
</section>

<section class="sh-license container">
  <div data-reveal class="sh-license-line">
    {t(locale, 'selfHost.license.text')}{' '}
    <a href="mailto:hello@letsylabs.com">{t(locale, 'selfHost.license.link')} →</a>
  </div>
</section>

<script>
  import { initFX } from '../../scripts/site-fx';
  initFX(document);
</script>

<style>
  .sh-audio {
    padding: 40px 32px 64px;
  }

  .sh-audio-label {
    text-align: center;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 1.5px;
    color: var(--muted);
    margin-bottom: 20px;
  }

  .sh-audio-box {
    max-width: 820px;
    margin: 0 auto;
    border: 1px dashed rgba(74, 242, 161, 0.35);
    border-radius: var(--radius-lg);
    padding: 28px;
    position: relative;
  }

  .sh-audio-badge {
    position: absolute;
    top: -9px;
    left: 24px;
    background: var(--bg);
    padding: 0 10px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 1px;
    color: var(--signal);
  }

  .sh-audio-row {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
    justify-content: center;
  }

  .sh-audio-node {
    background: var(--surface);
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: var(--radius-sm);
    padding: 14px 18px;
    font-family: var(--font-mono);
    font-size: 13px;
    text-align: center;
  }

  .sh-audio-node-signal {
    border-color: rgba(74, 242, 161, 0.4);
  }

  .sh-audio-node-event {
    border-color: rgba(88, 196, 246, 0.4);
  }

  .sh-audio-arrow {
    color: var(--signal);
  }

  .sh-audio-caption {
    text-align: center;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--muted);
    margin-top: 18px;
  }

  .sh-terminal-table {
    padding: 0 32px 72px;
    display: flex;
    flex-wrap: wrap;
    gap: 48px;
    align-items: flex-start;
  }

  .sh-terminal-col,
  .sh-comparison-col {
    flex: 1 1 400px;
    min-width: 300px;
  }

  :global(.sh-terminal) {
    box-shadow: var(--shadow-terminal);
  }

  :global(.sh-terminal .code-block-body) {
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 2;
  }

  .sh-requirements {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--muted);
    margin-top: 14px;
  }

  .sh-comparison-scroll {
    overflow-x: auto;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
  }

  .sh-comparison {
    min-width: 460px;
  }

  .sh-comparison-row {
    display: grid;
    grid-template-columns: 1.3fr 1fr 1fr;
    border-bottom: 1px solid var(--line);
  }

  .sh-comparison-row-last {
    border-bottom: none;
  }

  .sh-comparison-header {
    background: var(--surface);
  }

  .sh-comparison-cell {
    padding: 13px 18px;
    font-size: 13.5px;
  }

  .sh-comparison-header .sh-comparison-cell {
    padding: 14px 18px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 1px;
    color: var(--muted);
  }

  .sh-comparison-head-self {
    color: var(--signal);
  }

  .sh-comparison-label {
    color: var(--muted);
  }

  .sh-comparison-self-value {
    color: var(--signal);
  }

  .sh-security-chips {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-top: 16px;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--muted);
  }

  .sh-chip {
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-badge);
    padding: 3px 9px;
  }

  .sh-license {
    padding: 0 32px 88px;
  }

  .sh-license-line {
    font-size: 15px;
  }
</style>
