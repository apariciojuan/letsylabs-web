    align-items: center;
  }

  .cmp-export-copy {
    flex: 1 1 380px;
    min-width: 300px;
  }

  .cmp-export-h2 {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.5rem, 2.6vw, 1.875rem);
    letter-spacing: -0.6px;
    margin: 0 0 14px;
  }

  .cmp-export-text {
    font-size: 15px;
    line-height: 1.6;
    color: var(--muted);
    margin: 0 0 20px;
  }

  .cmp-export-checks {
    display: flex;
    flex-direction: column;
    gap: 10px;
    font-size: 14px;
    color: var(--muted);
  }

  .cmp-export-check {
    display: flex;
    align-items: baseline;
    gap: 10px;
  }

  .cmp-export-checkmark {
    font-family: var(--font-mono);
    color: var(--signal);
  }

  .cmp-export-sample {
    flex: 1 1 400px;
    min-width: 300px;
  }

  .cmp-export-card {
    background: var(--surface);
