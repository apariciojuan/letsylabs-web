    color: var(--muted);
    margin: 0;
  }

  .cmp-cta {
    border-top: 1px solid var(--line);
  }

  .cmp-cta-inner {
    max-width: 760px;
    margin: 0 auto;
    padding: 72px 32px;
    text-align: center;
  }

  .cmp-cta-h2 {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.625rem, 3vw, 2.125rem);
    letter-spacing: -0.6px;
    margin: 0 0 28px;
