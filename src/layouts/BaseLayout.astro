---
/**
 * Shared page shell (brief W-3 entregable W3-0): mounts the real SiteNav/SiteFooter (W-2) around
 * the page's content instead of the bootstrap's provisional `LangSwitch`-only bar — the language
 * switch now lives inside SiteNav and SiteFooter themselves. `<main id="top">` gets
 * `padding-top: var(--header-height)` to clear the fixed 64px header (README §Espaciado y forma);
 * `#top` is also the hero's anchor target (`<a href="#top">` on the logo).
 */
import '../styles/tokens.css';
import { locales } from '../i18n';
import { localizePath } from '../i18n/routing';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import type { Locale } from '../i18n';

interface Props {
  locale: Locale;
  title: string;
  description?: string;
}

const { locale, title, description } = Astro.props;
const pathname = Astro.url.pathname;
---

<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {
      locales.map((loc) => (
        <link rel="alternate" hreflang={loc} href={localizePath(pathname, loc)} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={localizePath(pathname, 'en')} />
  </head>
  <body>
    <SiteNav locale={locale} />
    <main id="top" class="base-layout-main">
      <slot />
    </main>
    <SiteFooter locale={locale} />
  </body>
</html>

<style>
  .base-layout-main {
    padding-top: var(--header-height);
  }
</style>
