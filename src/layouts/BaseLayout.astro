---
import '../styles/tokens.css';
import { locales } from '../i18n';
import { localizePath } from '../i18n/routing';
import LangSwitch from '../components/LangSwitch.astro';
import type { Locale } from '../i18n';

interface Props {
  locale: Locale;
  title: string;
}

const { locale, title } = Astro.props;
const pathname = Astro.url.pathname;
---

<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    {
      locales.map((loc) => (
        <link rel="alternate" hreflang={loc} href={localizePath(pathname, loc)} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={localizePath(pathname, 'en')} />
  </head>
  <body>
    <div class="lang-switch-bar"><LangSwitch locale={locale} pathname={pathname} /></div>
    <slot />
  </body>
</html>

<style>
  .lang-switch-bar {
    padding: 16px 32px;
  }
</style>
